{
  "name": "mana-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx watch server/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsx test/regression.test.ts && tsx test/conversation_simulation.test.ts && tsx test/gemini_production.test.ts && tsx test/repeat_response_fix.test.ts",
    "start": "tsx server/server.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@netlify/blobs": "^10.7.13",
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.109.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "lucide-react": "^1.16.0",
    "multer": "^2.4.0",
    "openai": "^4.85.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
