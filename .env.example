# Server Configuration
PORT=3001

# AI Model Keys (Optional - Built-in smart synthesis works out of the box without keys)
# Get free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Default AI Provider: gemini | openai | groq | builtin
DEFAULT_AI_PROVIDER=builtin

# Default Model
MODEL_NAME=gemini-1.5-flash

# Web Search Provider: duckduckgo | tavily | serper | brave
# Note: DuckDuckGo requires NO API key and works immediately!
DEFAULT_SEARCH_PROVIDER=duckduckgo

# Optional Search API Keys
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# =========================================================
# FEATURE 1: AI IMAGE GENERATION (OpenAI DALL-E 3)
# =========================================================
# Provide OPENAI_API_KEY above to use official OpenAI DALL-E 3 image generation.
# If omitted, Mana AI uses Pollinations AI (Flux.1) out of the box with zero keys required!

# =========================================================
# FEATURE 2: AI VIDEO GENERATION (Luma Dream Machine / Replicate)
# =========================================================
# Luma Dream Machine API (Ray-2 / Ray-Flash-2 models)
# Get key from: https://lumalabs.ai/dream-machine/api
# Generates 5s–9s cinematic video clips at 720p/1080p
LUMA_API_KEY=

# Replicate API (Alternative Video Engine for Wan-2.1 / Minimax Video)
# Get token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# RunwayML API (Alternative Gen-3 Alpha Turbo)
# Get key from: https://runwayml.com/
RUNWAY_API_KEY=
